{
  "name": "sizzla-3000",
  "version": "0.29.0",
  "private": true,
  "description": "Sizzla 3000 – lokal företagsadministration",
  "main": "src/desktop.cjs",
  "author": "Sizzla 3000",
  "scripts": {
    "start": "node src/server.cjs",
    "desktop": "electron .",
    "test": "node scripts/test-ci.cjs",
    "test:ui": "playwright test",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "se.sizzla.desktop",
    "productName": "Sizzla 3000",
    "files": [
      "src/**",
      "public/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "15.0",
      "artifactName": "Sizzla-3000-${version}-macOS-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fflate": "0.8.3",
    "read-excel-file": "9.3.15",
    "zod": "4.6.7"
  }
}
